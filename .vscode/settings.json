{
  // The venv you created one level above bdsim/ (see README). Adjust if yours
  // lives elsewhere; on Windows use "../.venv/Scripts/python.exe".
  "python.defaultInterpreterPath": "${workspaceFolder}/../.venv/bin/python",

  // Let Pylance resolve `import bdsim` from the source tree even before
  // `pip install -e .` (go-to-definition into python/bdsim/). Harmless once the
  // editable install is in place.
  "python.analysis.extraPaths": ["./python"],
  "python.analysis.typeCheckingMode": "basic"
}
